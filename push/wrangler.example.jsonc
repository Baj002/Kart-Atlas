{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kart-atlas",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {"directory": "../site", "binding": "ASSETS", "run_worker_first": ["/api/*", "/events.json", "/clubs.json", "/sw.js"]},
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {"SITE_ORIGIN": "https://YOUR-SITE.example", "VAPID_SUBJECT": "mailto:YOUR-SUPPORT-EMAIL"},
  "d1_databases": [{"binding": "DB", "database_name": "kart-atlas-push", "database_id": "SET-BY-SETUP", "migrations_dir": "migrations"}],
  "ratelimits": [{"name": "PUSH_RATE_LIMIT", "namespace_id": "734321", "simple": {"limit": 30, "period": 60}}],
  "observability": {"enabled": false}
}
