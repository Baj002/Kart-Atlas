{
  "name": "kart-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "North American competition kart race discovery",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mobile:prepare": "node mobile/prepare.mjs",
    "mobile:sync": "npm run mobile:prepare && node mobile/sync.mjs",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "test:mobile": "node tests/test_mobile.mjs",
    "release:check": "node mobile/release-check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.25.12"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
